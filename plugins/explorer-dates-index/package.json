{
  "name": "explorer-dates-index",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "quartz": {
    "name": "explorer-dates-index",
    "displayName": "Explorer Dates Index",
    "description": "Emits the explorer's light page index, latest modified timestamps, labels and pinned notes.",
    "version": "1.0.0",
    "category": "emitter",
    "defaultEnabled": true,
    "defaultOptions": {
      "outputPath": "static/explorerDates.json",
      "indexPath": "static/explorerIndex.json",
      "pinsPerFolder": 5,
      "pinMinBacklinks": 3
    }
  }
}
